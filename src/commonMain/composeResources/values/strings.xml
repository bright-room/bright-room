    <!-- Contributing -->
    <string name="contrib_label">Contributing</string>
    <string name="contrib_title">コントリビューションガイド</string>
    <string name="contrib_desc">bright-roomへの貢献は簡単な4ステップ。初めてのOSS貢献にもぴったりです。</string>
    <string name="contrib_step1_title">リポジトリをFork</string>
    <string name="contrib_step1_desc">貢献したいリポジトリをForkし、ローカルにCloneします。</string>
    <string name="contrib_step2_title">Branchを作成</string>
    <string name="contrib_step2_desc">feature/xxx や fix/xxx の形式で、変更内容がわかるブランチ名をつけます。</string>
    <string name="contrib_step3_title">コードを変更</string>
    <string name="contrib_step3_desc">コーディング規約に沿って開発し、テストを追加・実行してください。</string>
    <string name="contrib_step4_title">PRを送る</string>
    <string name="contrib_step4_desc">変更内容を説明したPull Requestを作成。レビューを受けてマージされます。</string>
    <string name="contrib_rules_title">コーディング規約 &amp; ルール</string>
    <string name="contrib_rule1">コミットメッセージは Conventional Commits 形式に従ってください（feat:, fix:, docs: など）</string>
    <string name="contrib_rule2">PRには変更内容の概要と、関連するIssue番号を記載してください</string>
    <string name="contrib_rule3">新機能にはテストを追加し、既存テストがパスすることを確認してください</string>
    <string name="contrib_rule4">コードスタイルは各リポジトリの ESLint / Prettier 設定に従います</string>
    <string name="contrib_rule5">大きな変更は事前にIssueやDiscussionで相談することを推奨します</string>

